# ServiceNow Instance Configuration
SN_INSTANCE=https://<your-dev-instance>.service-now.com

# ServiceNow DEV credentials
SN_DEV_INSTANCE=https://<your-dev-instance>.service-now.com
SN_DEV_USER=<dev-username>
SN_DEV_PASS=<dev-password>

# ServiceNow PROD credentials
SN_PROD_INSTANCE=https://<your-prod-instance>.service-now.com
SN_PROD_USER=<prod-username>
SN_PROD_PASS=<prod-password>

# Authentication State Storage
STORAGE_STATE_PATH=.auth/storageState.json

# Test Runner Configuration
HEADLESS=true
TIMEOUT_SECONDS=90
WORKERS=1
RETRIES=0
BROWSER=chromium

# SDK Deployment Alias (dev, prod)
SN_AUTH_ALIAS=dev
