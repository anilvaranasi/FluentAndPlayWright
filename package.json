{
  "name": "fluent-playwright-servicenow-framework",
  "version": "1.0.0",
  "description": "Unified ServiceNow DevOps Framework combining Fluent SDK, Gherkin/Cucumber BDD, and Playwright automated end-to-end testing with CI/CD pipeline",
  "private": true,
  "type": "commonjs",
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "scripts": {
    "build": "now-sdk build",
    "deploy": "now-sdk install",
    "transform": "now-sdk transform",
    "types": "now-sdk dependencies",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:fluent": "npx playwright test tests/fluent-app.spec.ts",
    "test:incident": "npx playwright test tests/incident-resolved-comment.spec.ts",
    "test:bdd": "cucumber-js --config cucumber.config.js",
    "test:bdd:incident": "cucumber-js --config cucumber.config.js --tags @incident-resolve",
    "typecheck": "npx tsc --noEmit",
    "pipeline:dev": "npm run build && npm run deploy -- --auth dev && npm run test",
    "pipeline:test": "npm run test"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.48.0",
    "@servicenow/glide": "27.0.5",
    "@servicenow/sdk": "4.13.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
